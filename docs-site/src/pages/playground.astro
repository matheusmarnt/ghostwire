---
import '../styles/landing.css';
// Ghostwire's own real stylesheet, imported as raw text (Vite's `?raw`
// suffix) — NOT as a normal CSS import. The synthesized bones live inside
// the iframe's own separate document (see the `paint()` function below),
// which has its own independent CSSOM; a normal frontmatter CSS import only
// reaches this PARENT page's <head> and would never style anything inside
// the iframe. The raw text gets injected directly into the iframe's own
// <head> every time it's repainted.
import ghostwireCss from '../../../js/src/style.css?raw';
import ThemeToggle from '../components/ThemeToggle.astro';
// Tailwind's OWN compiled output, as a plain string (Vite's `?inline`
// query — unlike `?raw`, this runs the full CSS pipeline, including the
// @tailwindcss/vite transform, so the string is real generated utility
// CSS, not just the unprocessed `@import "tailwindcss";` source). Needed
// because the preview iframe is a separate document written via
// doc.write() (see paint() below) — it never sees this page's own
// stylesheet <link>s, so any CSS the example markup needs has to travel
// as text, same as ghostwireCss already does.
import tailwindCss from '../styles/tailwind.css?inline';
// Raw source (not ?inline) — this only needs the plain --ghostwire-bone-*
// and --sl-color-* custom-property declarations, no build transform.
// Same reason as ghostwireCss above: the preview iframe is a separate
// document that never inherits this page's own :root, so without this
// its bones fall back to tokens.css's un-overridden default (OS
// prefers-color-scheme, disconnected from this site's own toggle).
import tokensCss from '../styles/tokens.css?raw';
const base = import.meta.env.BASE_URL;
const DEFAULT_MARKUP = `<div class="max-w-sm rounded-2xl border border-slate-200 bg-white p-5 font-sans shadow-sm">
  <div class="mb-4 flex items-center justify-between">
    <div>
      <h2 class="text-lg font-bold text-slate-900">Order #4821</h2>
      <p class="text-xs text-slate-500">Placed 3 minutes ago</p>
    </div>
    <span class="inline-flex items-center rounded-full bg-amber-100 px-2.5 py-1 text-xs font-medium text-amber-700">Processing</span>
  </div>
  <div class="mb-4 flex items-center gap-2.5 border-b border-slate-100 pb-4">
    <span class="flex h-8 w-8 items-center justify-center rounded-full bg-violet-100 text-xs font-semibold text-violet-700">JC</span>
    <span class="text-sm font-medium text-slate-700">Jane Cooper</span>
  </div>
  <div class="space-y-2.5">
    <div class="flex items-center justify-between text-sm">
      <span class="text-slate-600">Widget A &times; 2</span>
      <span class="font-medium text-slate-900">$12.00</span>
    </div>
    <div class="flex items-center justify-between text-sm">
      <span class="text-slate-600">Widget B &times; 1</span>
      <span class="font-medium text-slate-900">$8.50</span>
    </div>
  </div>
  <div class="mt-4 flex items-center justify-between border-t border-slate-100 pt-4">
    <span class="text-sm font-semibold text-slate-900">Total</span>
    <span class="text-lg font-bold text-slate-900">$20.50</span>
  </div>
</div>`;
---
<html lang="en">
<head>
  <script is:inline>
    const storedTheme =
      typeof localStorage !== 'undefined' && localStorage.getItem('starlight-theme');
    const theme =
      storedTheme ||
      (window.matchMedia('(prefers-color-scheme: light)').matches ? 'light' : 'dark');
    document.documentElement.dataset.theme = theme === 'light' ? 'light' : 'dark';
  </script>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Playground — Ghostwire</title>
  <link rel="icon" href={`${base}favicon.svg`} />
  <style>
    .gw-playground { max-width: 1100px; margin: 2rem auto; padding: 0 1.5rem; display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; }
    @media (max-width: 780px) { .gw-playground { grid-template-columns: 1fr; } }
    .gw-playground .cm-editor { width: 100%; }
    .gw-playground iframe { width: 100%; height: 340px; border: 1px solid var(--gw-border); border-radius: 0.5rem; background: #fff; }
    .gw-playground-actions { margin: 0.75rem 0; display: flex; align-items: center; gap: 0.5rem; }
    .gw-playground-actions button { background: var(--sl-color-accent); color: var(--gw-on-accent); border: none; padding: 0.5rem 1rem; border-radius: 0.4rem; cursor: pointer; }
    .gw-playground-actions button.secondary { background: transparent; border: 1px solid var(--gw-border); color: var(--gw-fg); }
    .gw-playground-actions .gw-live-indicator { margin-left: auto; font-size: 0.75rem; color: var(--gw-muted); display: flex; align-items: center; gap: 0.4rem; }
    .gw-playground-actions .gw-live-dot { width: 0.45rem; height: 0.45rem; border-radius: 999px; background: #22c55e; box-shadow: 0 0 6px #22c55e; }
    .gw-note { max-width: 1100px; margin: 0 auto 1rem; padding: 0 1.5rem; color: var(--gw-muted); font-size: 0.85rem; }
  </style>
</head>
<body>
  <ThemeToggle />
  <section class="gw-hero">
    <h1>Playground</h1>
    <p>Edit the markup on the left. Click "Synthesize" to run Ghostwire's real, unmodified synthesizer against the live preview on the right.</p>
  </section>
  <p class="gw-note">This edits an HTML/Blade-flavored subset, not full Blade — the synthesizer walks the live rendered DOM, exactly as it does inside a real Livewire component, so what you see here is genuinely how Ghostwire would skeletonize this markup in your app. The preview updates as you type; click "Synthesize" to run Ghostwire's real, unmodified synthesizer against it.</p>

  <div class="gw-playground">
    <div id="markup-editor"></div>
    <div>
      <iframe id="preview-frame" title="Live preview"></iframe>
    </div>
  </div>
  <div class="gw-playground-actions" style="max-width:1100px;margin:0 auto;padding:0 1.5rem;">
    <button type="button" id="synthesize-btn">Synthesize</button>
    <button type="button" id="reset-btn" class="secondary">Reset</button>
    <span class="gw-live-indicator"><span class="gw-live-dot"></span> Live preview</span>
  </div>
  <nav class="gw-footer-nav"><a href={`${base}`}>Home</a> <a href={`${base}gallery/`}>Gallery</a></nav>

  <!-- Inert data carrier for the CSS text — a `type="text/plain"` script
       tag is never executed by the browser AND (because it has an
       attribute) is never bundled/processed by Astro either, so this
       server-rendered text survives untouched for the real script below to
       read at runtime. This avoids `define:vars`, which inlines a script
       and does not resolve its `import` statements — incompatible with the
       real `js/src/*` imports this page needs. The CSS travels via a
       `data-css` attribute rather than the tag's text content: Astro's
       compiler does not evaluate `{}` expressions inside a <script> tag's
       text node (verified against the built output), but it does evaluate
       them in attribute values on any element, script included. -->
  <script type="text/plain" id="ghostwire-css-source" data-css={ghostwireCss}></script>
  <!-- Same trick, for Tailwind's compiled CSS — the example markup uses
       Tailwind utility classes, which only render inside the preview
       iframe if its own document gets this text too. -->
  <script type="text/plain" id="tailwind-css-source" data-css={tailwindCss}></script>
  <!-- Same trick, for tokens.css's --ghostwire-bone-* override (pinned to
       data-theme instead of OS prefers-color-scheme) — without this the
       preview's real bones ignore this site's own light/dark toggle. -->
  <script type="text/plain" id="tokens-css-source" data-css={tokensCss}></script>
  <!-- Same inert-data-carrier trick as ghostwire-css-source above, for the
       editor's initial content — CodeMirror needs a plain string to boot
       from, not a textarea's server-rendered value. -->
  <script type="text/plain" id="default-markup-source" data-markup={DEFAULT_MARKUP}></script>

  <script>
    import { createRegistry } from '../../../js/src/registry.js';
    import { createSynthesizer } from '../../../js/src/synthesizer/index.js';
    import { createRenderer } from '../../../js/src/renderer.js';
    import { createPlaygroundEditor } from '../lib/playground-editor.js';

    const editorContainer = document.getElementById('markup-editor');
    const frame = document.getElementById('preview-frame');
    const synthesizeBtn = document.getElementById('synthesize-btn');
    const resetBtn = document.getElementById('reset-btn');
    const ghostwireCss = document.getElementById('ghostwire-css-source').dataset.css;
    const tailwindCss = document.getElementById('tailwind-css-source').dataset.css;
    // Strips the Google Fonts @import — the iframe repaints on every edit,
    // and re-fetching that stylesheet each time is pure waste; the iframe
    // doesn't render any of this page's own font-driven UI anyway.
    const tokensCss = document.getElementById('tokens-css-source').dataset.css.replace(/@import[^;]+;/, '');
    const DEFAULT_MARKUP = document.getElementById('default-markup-source').dataset.markup;

    const registry = createRegistry();
    const synthesizer = createSynthesizer(registry);
    const renderer = createRenderer();
    let host = null;

    // Live preview: paint on every debounced edit (playground-editor.js
    // debounces at 250ms). This only repaints the CONTENT — the ghost
    // skeleton itself stays an explicit "Synthesize" click, both because
    // continuously re-synthesizing on every keystroke would restart the
    // shimmer constantly, and because it mirrors the real product: a
    // request START triggers synthesis, not every content change.
    const editor = createPlaygroundEditor(editorContainer, DEFAULT_MARKUP, () => {
      paint(editor.getValue());
      if (host) { renderer.removeLayer(host); registry.detach(host); host = null; }
    });

    function paint(markup) {
      const doc = frame.contentDocument;
      const theme = document.documentElement.dataset.theme === 'light' ? 'light' : 'dark';
      doc.open();
      doc.write(`<!doctype html><html data-theme="${theme}"><head><meta charset="utf-8"><style>${tokensCss}</style><style>${tailwindCss}</style><style>${ghostwireCss}</style></head><body style="margin:0;padding:16px;">${markup}</body></html>`);
      doc.close();
    }

    // The toggle only fires paint() indirectly (via a subsequent edit) —
    // without this, switching theme mid-session leaves the preview (and
    // any already-mounted skeleton) on whatever theme it last painted
    // under until the user types again.
    window.addEventListener('gw-theme-change', () => {
      paint(editor.getValue());
      if (host) {
        // Bones already painted under the old theme's --ghostwire-bone-*
        // values (set as literal computed colors at render time, not live
        // CSS var() references) — repainting the iframe alone won't
        // re-color them, so re-synthesize against the fresh theme instead
        // of leaving a stale-colored skeleton on screen.
        renderer.removeLayer(host);
        registry.detach(host);
        host = null;
        requestAnimationFrame(() => requestAnimationFrame(synthesize));
      }
    });

    function synthesize() {
      const doc = frame.contentDocument;
      const target = doc.body;
      if (host) { renderer.removeLayer(host); registry.detach(host); host = null; }
      host = registry.attach(target, { id: 'playground' }, { rows: null });
      // The Ghost Layer must live in the SAME document as the host it
      // measures against (getBoundingClientRect coordinates are document-
      // relative) — mount into the iframe's own document, not the parent page's.
      const layer = doc.createElement('div');
      layer.className = 'gw-layer';
      layer.style.position = 'absolute';
      layer.style.top = '0';
      layer.style.left = '0';
      layer.style.right = '0';
      layer.style.bottom = '0';
      // Explicit opt-out: the layer is a CHILD of `target` (doc.body) below,
      // so it would otherwise inherit the `visibility: hidden` set on target
      // a few lines down — visibility is inherited unless overridden.
      layer.style.visibility = 'visible';
      doc.body.style.position = 'relative';
      doc.body.appendChild(layer);
      host.layer = layer;

      const boneTree = synthesizer.synthesize(host);
      target.style.visibility = 'hidden';
      if (boneTree) renderer.renderBones(host, boneTree);
    }

    synthesizeBtn.addEventListener('click', () => {
      paint(editor.getValue());
      // Wait one frame so the iframe has actually laid out the new markup
      // before measuring it (never measure mid-paint).
      requestAnimationFrame(() => requestAnimationFrame(synthesize));
    });

    resetBtn.addEventListener('click', () => {
      editor.setValue(DEFAULT_MARKUP);
      paint(DEFAULT_MARKUP);
      if (host) { renderer.removeLayer(host); registry.detach(host); host = null; }
    });

    paint(editor.getValue());
  </script>
</body>
</html>
